// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}

model AppSetting {
 id String @id
 value Json
 updatedAt DateTime @updatedAt
}

model ProtectedProperty {
 id String @id @default(cuid())
 name String
 parcelNumber String
 landTrust String
 ownerName String
 areaHectares Float
 monitoringDueAt DateTime
 status String @default("Draft")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 inverseEasementTerm_protectedPropertyId EasementTerm[] @relation("EasementTerm_protectedPropertyId")
 inverseBaselineReport_protectedPropertyId BaselineReport[] @relation("BaselineReport_protectedPropertyId")
 inverseStewardshipVisit_protectedPropertyId StewardshipVisit[] @relation("StewardshipVisit_protectedPropertyId")
 inverseLandownerContact_protectedPropertyId LandownerContact[] @relation("LandownerContact_protectedPropertyId")
 inverseUseRequest_protectedPropertyId UseRequest[] @relation("UseRequest_protectedPropertyId")
 inversePotentialViolation_protectedPropertyId PotentialViolation[] @relation("PotentialViolation_protectedPropertyId")
 inverseRestorationAction_protectedPropertyId RestorationAction[] @relation("RestorationAction_protectedPropertyId")
 inverseStewardshipExpense_protectedPropertyId StewardshipExpense[] @relation("StewardshipExpense_protectedPropertyId")
 inverseOperationalTask_protectedPropertyId OperationalTask[] @relation("OperationalTask_protectedPropertyId")
 inverseRuleVersion_protectedPropertyId RuleVersion[] @relation("RuleVersion_protectedPropertyId")
 inverseDocumentRequirement_protectedPropertyId DocumentRequirement[] @relation("DocumentRequirement_protectedPropertyId")
}

model EasementTerm {
 id String @id @default(cuid())
 title String
 sectionNumber String
 restrictionText String
 allowedUse String
 version String
 effectiveAt DateTime
 status String @default("Draft")
 protectedPropertyId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([protectedPropertyId])
 linkedProtectedPropertyId ProtectedProperty @relation("EasementTerm_protectedPropertyId", fields: [protectedPropertyId], references: [id], onDelete: Restrict)
}

